# Copy to .env and fill in real values. Never commit .env.
# Supabase Postgres connection string (use pooled URL, port 6543, for local dev and Railway).
DB_URL=postgresql://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true
# Public base URL of the API. Used to build display URLs in publish responses.
# Local: http://localhost:8080 | Railway: https://YOUR-APP.up.railway.app
BASE_URL=http://localhost:8080

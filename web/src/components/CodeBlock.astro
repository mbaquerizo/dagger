---
// Beveled code frame. Set `compact` for dense payloads, `capped` to cap height.
interface Props {
  compact?: boolean;
  capped?: boolean;
}
const { compact = false, capped = false } = Astro.props;
---
<pre
  data-code
  class:list={[
    'overflow-x-auto rounded-lg bg-white p-4 font-mono leading-relaxed text-slate-800',
    compact ? 'text-[0.8rem]' : 'text-sm',
    capped && 'max-h-96 overflow-auto',
  ]}
><code><slot /></code></pre>

<style>
  [data-code] {
    border: 1px solid #e2e8f0;
    box-shadow:
      inset 0 1px 0 #ffffff,
      inset 0 -1px 0 #f1f5f9,
      0 1px 2px rgba(15, 23, 42, 0.06);
  }
</style>

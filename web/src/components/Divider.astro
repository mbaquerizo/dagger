---
// Blade divider. Glint vars (--dp/--do) are set per element from the page script.
---
<div data-divider aria-hidden="true"></div>

<style>
  [data-divider] {
    position: relative;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      #cbd5e1 12%,
      #f1f5f9 50%,
      #cbd5e1 88%,
      transparent
    );
  }

  [data-divider]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(148, 163, 184, 0.6) 38%,
      rgba(255, 255, 255, 1) 50%,
      rgba(148, 163, 184, 0.6) 62%,
      transparent 100%
    );
    background-size: 28% 100%;
    background-repeat: no-repeat;
    background-position: var(--dp, -50%) 0;
    opacity: var(--do, 0);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-divider]::after {
      display: none;
    }
  }
</style>
